#!/bin/sh
# Stands in for pacman in the helper tests. Prints what pacman -Syu prints
# with LC_ALL=C and --noprogressbar. Behaviour comes from files next to it,
# because the helper clears the environment:
#   mode   normal | nothing | fail | provider | conflict | replace | key | unknown
#   delay  seconds per package (default 0)
#   pacnew settings file to report a .pacnew for (default /etc/kyu-test.conf)
dir=$(dirname "$0")
mode=$(cat "$dir/mode" 2>/dev/null || echo normal)
delay=$(cat "$dir/delay" 2>/dev/null || echo 0)

[ "$LC_ALL" = C ] || { echo "error: LC_ALL is '$LC_ALL', expected C" >&2; exit 1; }
[ "$*" = "-Syu --noprogressbar --color never" ] || { echo "error: unexpected arguments: $*" >&2; exit 1; }

echo ":: Synchronizing package databases..."
echo " core is up to date"
echo " extra is up to date"
echo ":: Starting full system upgrade..."
if [ "$mode" = nothing ]; then
    echo " there is nothing to do"
    exit 0
fi
echo "resolving dependencies..."
echo "looking for conflicting packages..."
packages="kwin linux618 mesa"
case "$mode" in
provider)
    # The list goes to stdout and the question to stderr, as in pacman.
    echo ":: There are 3 providers available for vulkan-driver:"
    echo ":: Repository extra"
    echo "   1) nvidia-utils  2) vulkan-intel  3) vulkan-radeon"
    echo ""
    printf 'Enter a number (default=1): ' >&2
    read -r answer
    case "$answer" in
    1) packages="$packages nvidia-utils" ;;
    2) packages="$packages vulkan-intel" ;;
    3) packages="$packages vulkan-radeon" ;;
    *) echo "error: invalid number: '$answer'" >&2; exit 1 ;;
    esac
    ;;
conflict)
    printf ':: foo and bar are in conflict. Remove bar? [y/N] ' >&2
    read -r answer
    if [ "$answer" != y ]; then
        echo "error: unresolvable package conflicts detected" >&2
        echo "error: failed to prepare transaction (conflicting dependencies)" >&2
        exit 1
    fi
    packages="$packages bar-removed"
    ;;
replace)
    printf ':: Replace oldthing with extra/newthing? [Y/n] ' >&2
    read -r answer
    [ "$answer" = y ] && packages="$packages newthing"
    ;;
unknown)
    printf ':: Something Kyu has never seen? [Y/n] ' >&2
    read -r answer
    echo "error: the helper answered '$answer' instead of stopping pacman" >&2
    exit 1
    ;;
esac
echo ""
echo "Packages ($(echo $packages | wc -w)) $packages"
echo ""
echo "Total Download Size:    40.00 MiB"
echo "Net Upgrade Size:        1.40 MiB"
echo ""
printf ':: Proceed with installation? [Y/n] ' >&2
read -r answer
[ "$answer" = y ] || { echo "error: expected answer y, got '$answer'" >&2; exit 1; }
echo ":: Retrieving packages..."
echo "checking keyring..."
if [ "$mode" = key ]; then
    printf ':: Import PGP key 0123ABCD, "Packager <p@example.org>"? [Y/n] ' >&2
    read -r answer
    if [ "$answer" != y ]; then
        echo "error: required key missing from keyring" >&2
        echo "error: failed to commit transaction (unexpected error)" >&2
        exit 1
    fi
fi
echo "checking package integrity..."
echo ":: Processing package changes..."
for p in $packages; do
    case "$p" in
    bar-removed) echo "removing bar..." ;;
    nvidia-utils | vulkan-* | newthing) echo "installing $p..." ;;
    *) echo "upgrading $p..." ;;
    esac
    sleep "$delay"
    if [ "$mode" = fail ] && [ "$p" = linux618 ]; then
        echo "error: failed to commit transaction (conflicting files)" >&2
        exit 1
    fi
done
if [ "$mode" = normal ]; then
    pacnew=$(cat "$dir/pacnew" 2>/dev/null || echo /etc/kyu-test.conf)
    echo "warning: $pacnew installed as $pacnew.pacnew" >&2
fi
echo ":: Running post-transaction hooks..."
echo "(1/1) Arming ConditionNeedsUpdate..."
exit 0
