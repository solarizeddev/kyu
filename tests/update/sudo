#!/bin/sh
# Stands in for sudo in tests/kyu_update_test.sh: runs the command as is,
# or, with KYU_FAKE_SUDO=refuse, refuses as sudo does after three wrong
# passwords.
if [ "$KYU_FAKE_SUDO" = refuse ]; then
    echo "[sudo] password for tester: " >&2
    echo "sudo: 3 incorrect password attempts" >&2
    exit 1
fi
exec "$@"
