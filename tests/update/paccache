#!/bin/sh
# Stands in for paccache (pacman-contrib) in tests/kyu_update_test.sh: no
# candidates, or with KYU_FAKE_CACHE=big a 2 GiB old version (a sparse file)
# until cleaned. Records each cleaning run in paccache-args.
d=$KYU_FAKE_DIR/cache
case "$1" in
-d)
    if [ "${KYU_FAKE_CACHE:-}" = big ] && [ ! -e "$KYU_FAKE_DIR/cache-cleaned" ]; then
        mkdir -p "$d"
        [ -e "$d/mesa-1:26.1.0-1-x86_64.pkg.tar.zst" ] || truncate -s 2G "$d/mesa-1:26.1.0-1-x86_64.pkg.tar.zst"
        echo "==> Candidate packages:"
        echo "$d/mesa-1:26.1.0-1-x86_64.pkg.tar.zst"
        echo
        echo "==> finished dry run: 1 candidates (disk space saved: 2.00 GiB)"
    else
        echo "==> no candidate packages found for pruning"
    fi ;;
-r*)
    echo "$*" >>"$KYU_FAKE_DIR/paccache-args"
    touch "$KYU_FAKE_DIR/cache-cleaned" ;;
*) echo "fake paccache: unexpected arguments: $*" >&2; exit 2 ;;
esac
