#!/bin/sh
# Stands in for pacman in tests/kyu_update_test.sh. Prints what pacman -Syu
# prints, asks "Proceed?" on the terminal, and appends what pacman would to
# the fake pacman.log. KYU_FAKE_MODE: normal | keyring | slow | systemd
# (upgrades systemd) | nothing | midfail (fails after one package) | german |
# interrupt (Ctrl+C at "Proceed?") | germankeyring.
# The keyrings (first, or the keyring fix): up to date, or with
# KYU_FAKE_KEYRING=new, upgraded after a "Proceed?" (once: then up to date),
# or with KYU_FAKE_KEYRING=untrusted, refused for its signature.
log=$KYU_FAKE_DIR/pacman.log
now() { date +%Y-%m-%dT%H:%M:%S%z; }
# The sync: new package lists (KYU_FAKE_SYNC=same: nothing new).
synced() { [ "${KYU_FAKE_SYNC:-}" = same ] || { mkdir -p "$KYU_FAKE_DIR/sync" && touch -d "@$(($(date +%s) + 7))" "$KYU_FAKE_DIR/sync/core.db"; }; }
case "$*" in
"-Sy --needed "* | "-Syy --needed "*)
    echo "$*" >"$KYU_FAKE_DIR/keyring-args"
    touch "$KYU_FAKE_DIR/keyring-fixed"
    echo ":: Synchronizing package databases..."; synced
    shift 2
    if [ "${KYU_FAKE_KEYRING:-}" = untrusted ]; then
        echo "error: archlinux-keyring: signature from \"Someone New <n@example.org>\" is unknown trust" >&2
        echo "error: failed to commit transaction (invalid or corrupted package (PGP signature))" >&2
        echo "Errors occurred, no packages were upgraded." >&2
        exit 1
    fi
    if [ "${KYU_FAKE_KEYRING:-}" != new ] || [ -e "$KYU_FAKE_DIR/keyring-upgraded" ]; then
        for k in "$@"; do echo "warning: $k-1-1 is up to date -- skipping"; done
        echo " there is nothing to do"
        exit 0
    fi
    echo "resolving dependencies..."
    echo ""
    echo "Packages ($#) $*"
    echo ""
    printf ':: Proceed with installation? [Y/n] '
    read -r answer || exit 1
    case "$answer" in n|N) exit 1 ;; esac
    echo "[$(now)] [ALPM] transaction started" >>"$log"
    for k in "$@"; do
        echo "(1/$#) upgrading $k"
        echo "[$(now)] [ALPM] upgraded $k (1-1 -> 2-1)" >>"$log"
    done
    echo "[$(now)] [ALPM] transaction completed" >>"$log"
    touch "$KYU_FAKE_DIR/keyring-upgraded"
    exit 0 ;;
-Qtdq)
    # Orphans: KYU_FAKE_ORPHANS, until removed (-Rs).
    [ -n "${KYU_FAKE_ORPHANS:-}" ] && [ ! -e "$KYU_FAKE_DIR/orphans-removed" ] || exit 1
    for o in $KYU_FAKE_ORPHANS; do echo "$o"; done
    exit 0 ;;
"-Rs --print --print-format %n "* | "-R --print --print-format %n "*)
    # What -Rs would remove: the targets and KYU_FAKE_ORPHAN_DEPS (-R: the
    # targets). KYU_FAKE_DRYRUN=fail: pacman cannot work it out.
    [ "${KYU_FAKE_DRYRUN:-}" = fail ] && { echo "error: failed to prepare transaction" >&2; exit 1; }
    mode=$1; shift 4
    for o in "$@"; do echo "$o"; done
    [ "$mode" = -Rs ] && for o in ${KYU_FAKE_ORPHAN_DEPS:-}; do echo "$o"; done
    exit 0 ;;
"-Rs "* | "-R "*)
    echo "$*" >"$KYU_FAKE_DIR/remove-args"
    shift
    echo "checking dependencies..."
    echo ""
    echo "Packages ($#) $*"
    echo ""
    printf ':: Do you want to remove these packages? [Y/n] '
    read -r answer || exit 1
    case "$answer" in n|N) exit 1 ;; esac
    for o in "$@"; do echo "removing $o..."; done
    touch "$KYU_FAKE_DIR/orphans-removed"
    exit 0 ;;
-Syu | -Syyu | -Su) echo "$1" >"$KYU_FAKE_DIR/pacman-args" ;;
*) echo "fake pacman: unexpected arguments: $*" >&2; exit 2 ;;
esac
touch "$KYU_FAKE_DIR/pacman-ran"
echo "[$(now)] [PACMAN] Running 'pacman $1'" >>"$log"
[ "$1" = -Su ] || { echo ":: Synchronizing package databases..."; synced; }
echo ":: Starting full system upgrade..."
echo "[$(now)] [PACMAN] starting full system upgrade" >>"$log"
if [ "${KYU_FAKE_MODE:-}" = nothing ]; then
    echo " there is nothing to do"
    exit 0
fi
# lockedonce: another package manager took the lock first, the first time.
if [ "${KYU_FAKE_MODE:-}" = lockedonce ] && [ ! -e "$KYU_FAKE_DIR/locked-once" ]; then
    touch "$KYU_FAKE_DIR/locked-once"
    echo "error: failed to init transaction (unable to lock database)" >&2
    echo "error: could not lock database: File exists" >&2
    exit 1
fi
# germankeyring: the keyring failure as German pacman prints it (the test
# catalogs in tests/update/locale turn it back).
if [ "${KYU_FAKE_MODE:-}" = germankeyring ]; then
    # (German pacman leaves the signature line in English.)
    echo "Fehler: mesa: signature from \"Someone <s@example.org>\" is unknown trust" >&2
    echo "Fehler: Der Vorgang konnte nicht durchgeführt werden (Ungültiges oder beschädigtes Paket (PGP-Signatur))" >&2
    echo "Fehler sind aufgetreten, keine Pakete wurden aktualisiert." >&2
    exit 1
fi
if [ "${KYU_FAKE_MODE:-}" = deps ]; then
    echo "error: failed to prepare transaction (could not satisfy dependencies)" >&2
    echo ":: installing zlib (1:1.4-1) breaks dependency 'zlib=1:1.3.2-3' required by foo" >&2
    exit 1
fi
if [ "${KYU_FAKE_MODE:-}" = german ]; then
    echo "Fehler: Konnte Datei 'core.db' nicht von mirror.example.org übertragen" >&2
    echo "Fehler: Konnte nicht alle Datenbanken aktualisieren" >&2
    exit 1
fi
echo "resolving dependencies..."
echo "looking for conflicting packages..."
echo ""
echo "Packages (2) linux618-6.18.22-1  mesa-1:26.2.3-1"
echo ""
printf ':: Proceed with installation? [Y/n] '
if [ "${KYU_FAKE_MODE:-}" = interrupt ]; then
    echo; echo "interrupt signal received" >&2; exit 130
fi
read -r answer || exit 1 # no answer: as if interrupted
case "$answer" in n|N) exit 1 ;; esac
echo ":: Retrieving packages..."
if [ "${KYU_FAKE_MODE:-}" = slow ]; then
    # A download line redrawn in place, as pacman's progress bar is.
    for p in 10 35 60 85; do
        printf '\r mesa-1:26.2.3-1-x86_64      %3s MiB  %s%%' $((p / 4)) "$p"
        sleep 0.75
    done
    printf '\r mesa-1:26.2.3-1-x86_64       25 MiB  100%%\n'
fi
if [ "${KYU_FAKE_MODE:-}" = keyring ]; then
    echo "(2/2) checking keys in keyring"
    echo "error: mesa: signature from \"Someone <s@example.org>\" is unknown trust" >&2
    echo "error: failed to commit transaction (invalid or corrupted package (PGP signature))" >&2
    echo "Errors occurred, no packages were upgraded." >&2
    exit 1
fi
echo "[$(now)] [ALPM] transaction started" >>"$log"
if [ "${KYU_FAKE_MODE:-}" = systemd ]; then
    echo "(1/1) upgrading systemd"
    echo "[$(now)] [ALPM] upgraded systemd (258.1-1 -> 258.2-1)" >>"$log"
    echo "[$(now)] [ALPM] transaction completed" >>"$log"
    exit 0
fi
echo "(1/2) upgrading linux618"
echo "[$(now)] [ALPM] upgraded linux618 (6.18.20-1 -> 6.18.22-1)" >>"$log"
if [ "${KYU_FAKE_MODE:-}" = midfail ]; then
    echo "error: could not extract /usr/lib/mesa/x.so (Write error)" >&2
    echo "[$(now)] [ALPM] transaction failed" >>"$log"
    exit 1
fi
echo "(2/2) upgrading mesa"
echo "[$(now)] [ALPM] upgraded mesa (1:26.2.1-1 -> 1:26.2.3-1)" >>"$log"
echo "warning: /etc/sddm.conf installed as /etc/sddm.conf.pacnew"
echo "[$(now)] [ALPM] warning: /etc/sddm.conf installed as /etc/sddm.conf.pacnew" >>"$log"
echo "[$(now)] [ALPM] transaction completed" >>"$log"
