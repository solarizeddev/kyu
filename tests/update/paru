#!/bin/sh
# Stands in for paru in tests/kyu_update_test.sh: "paru -Sua" upgrades one
# AUR package after a "Proceed?", and logs it as pacman would.
# KYU_FAKE_AUR=fail: the build fails.
echo "$*" >"$KYU_FAKE_DIR/aur-args"
# What Kyu saved before the AUR step.
cp "$XDG_STATE_HOME/kyu/last-run.json" "$KYU_FAKE_DIR/last-run-before-aur.json" 2>/dev/null
log=$KYU_FAKE_DIR/pacman.log
now() { date +%Y-%m-%dT%H:%M:%S%z; }
echo ":: Looking for AUR upgrades..."
echo ":: Resolving dependencies..."
echo ""
echo "Aur (1)    foo-bin-2-1"
echo ""
printf ':: Proceed to review? [Y/n]: '
read -r answer || exit 1
case "$answer" in n|N) exit 1 ;; esac
if [ "${KYU_FAKE_AUR:-}" = fail ]; then
    echo "==> ERROR: A failure occurred in build()." >&2
    echo "error: packages failed to build: foo-bin-2-1" >&2
    exit 1
fi
echo "[$(now)] [ALPM] transaction started" >>"$log"
echo "[$(now)] [ALPM] installed foo-makedep (1-1)" >>"$log"
echo "[$(now)] [ALPM] upgraded foo-bin (1-1 -> 2-1)" >>"$log"
echo "[$(now)] [ALPM] removed foo-makedep (1-1)" >>"$log"
echo "[$(now)] [ALPM] transaction completed" >>"$log"
echo "(1/1) upgrading foo-bin"
