[Unit]
Description=Check for pacman and Flatpak updates (Kyu)
Documentation=https://github.com/solarizeddev/kyu

[Service]
Type=oneshot
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/kyu-check
# Network checks; keep them out of the way of interactive work.
Nice=10
TimeoutStartSec=16min
IOSchedulingClass=idle
