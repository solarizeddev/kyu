<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Kyu</vendor>
  <vendor_url>https://github.com/solarizeddev/kyu</vendor_url>
  <action id="io.github.solarizeddev.kyu.update">
    <description>Update all packages</description>
    <message>Kyu needs to run "pacman -Syu" as root.</message>
    <icon_name>update-low</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
