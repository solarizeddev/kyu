[Global]
IconName=system-software-update
Comment=Kyu
Comment[de]=Kyu
DesktopEntry=@KYU_APP_ID@

[Event/news]
Name=Read before updating
Name[de]=Vor dem Aktualisieren lesen
Comment=A new announcement from your distribution, once; it stays until dismissed
Comment[de]=Eine neue Ankündigung der Distribution, einmal; sie bleibt, bis sie geschlossen wird
Action=Popup
Urgency=Normal

[Event/waitingForYou]
Name=The update is waiting for you
Name[de]=Die Aktualisierung wartet auf eine Eingabe
Comment=pacman, sudo or Kyu asks a question while the Kyu window is not in front
Comment[de]=pacman, sudo oder Kyu stellt eine Frage, während das Kyu-Fenster nicht im Vordergrund ist
Action=Popup
Urgency=High

[Event/updates]
Name=Updates available
Name[de]=Aktualisierungen verfügbar
Comment=When updates appear after there were none; at most once a day, after any news is read
Comment[de]=Wenn nach einer Zeit ohne Aktualisierungen neue erscheinen; höchstens einmal am Tag, nachdem alle Neuigkeiten gelesen sind
Action=Popup
Urgency=Normal
