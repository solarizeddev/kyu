[Unit]
Description=Check for updates hourly (Kyu)
Documentation=https://github.com/solarizeddev/kyu

[Timer]
# kyu-tray starts this timer at login. To check without the tray:
#   systemctl --user enable --now kyu-check.timer
OnActiveSec=2min
# On the clock (wall time), so a check missed while the computer slept runs
# when it wakes; Persistent also catches up a time logged out or powered off.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
