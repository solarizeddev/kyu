#!/bin/sh
# Stands in for kyu-check in tools/kyu-demo.sh: "checks" by writing the
# scenario's after-update state ($KYU_DEMO_AFTER), as if everything was
# installed. Never touches pacman or the network.
set -eu
dir="${XDG_STATE_HOME:?}/kyu"
mkdir -p "$dir"
sleep 1
cp "${KYU_DEMO_AFTER:?}" "$dir/updates.json.tmp"
mv "$dir/updates.json.tmp" "$dir/updates.json"
