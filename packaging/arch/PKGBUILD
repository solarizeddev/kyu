# Builds and packages the Kyu checkout this file sits in, for testing on a
# real system. Not an AUR package: it has no source=() and uses the working
# tree as it is (including uncommitted changes).
#
#   cd packaging/arch && makepkg -sif         build, run the tests, install
#   makepkg -sif --nocheck                    skip the tests
# (-f rebuilds even when a package of this version was built before: the
# version does not change with your edits.)
#   sudo pacman -R kyu-git                    remove it again

pkgname=kyu-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Plasma update notifier for Manjaro and Arch: the real pacman in a terminal, with the news first and what is left to do after'
arch=(x86_64 aarch64)
url='https://github.com/solarizeddev/kyu'
license=(GPL-3.0-or-later)
depends=(
    dbus
    diffutils
    flatpak
    gcc-libs
    glibc
    kcoreaddons
    kiconthemes
    knotifications
    konsole
    kparts
    kstatusnotifieritem
    kwindowsystem
    pacman
    pacman-contrib
    qt6-base
    sudo
    systemd
    util-linux
)
makedepends=(cmake ninja)
provides=(kyu)
conflicts=(kyu)

_root=$(realpath "$startdir/../..")

build() {
    cmake -S "$_root" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKYU_REQUIRE_KSNI=ON \
        -DKYU_REQUIRE_WINDOW=ON \
        -DKYU_REQUIRE_NOTIFICATIONS=ON
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
